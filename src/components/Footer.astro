---
import TideLine from './TideLine.astro';

const year = new Date().getFullYear();
---

<footer class="mt-32">
  <!-- Same tideline as the homepage section break, so the page opens and
       closes on the same mark rather than mixing a wave with a hairline. -->
  <div class="mx-auto max-w-5xl px-6 sm:px-8">
    <TideLine class="h-6 w-full text-seaglass-200" />
  </div>

  <div class="mx-auto max-w-5xl px-6 pt-8 pb-14 sm:px-8">
    <p class="font-display max-w-2xl text-2xl leading-snug text-kelp-900">
      Currently open to opportunities driving systemic change through social and
      physical infrastructure.
    </p>

    <div class="font-ui mt-8 flex flex-wrap items-center gap-x-8 gap-y-3 text-sm">
      <span class="inline-flex items-center">
        <!-- Decorative — the link text already says what it does. -->
        <span aria-hidden="true" class="mr-1.5">✉️</span>
        <a
          href="mailto:meeseachelle@gmail.com"
          class="text-tide-600 underline decoration-1 underline-offset-4 hover:text-tide-800"
        >
          Send me a note
        </a>
      </span>
      <a
        href="https://www.linkedin.com/in/mchang1/"
        rel="me noopener"
        class="group/li inline-flex items-center gap-1.5 text-fog-500 no-underline hover:text-kelp-900"
      >
        <!-- Outline mark drawn as strokes rather than LinkedIn's solid glyph,
             so it matches the hairline weight of the rest of the site and
             inherits currentColor on hover. Decorative: the link text already
             names the destination. -->
        <svg
          viewBox="0 0 24 24"
          class="h-[1.05em] w-[1.05em] shrink-0"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          focusable="false"
        >
          <rect x="3" y="3" width="18" height="18" rx="3"></rect>
          <path d="M7.5 10.5v6"></path>
          <circle cx="7.5" cy="7.6" r="0.9" fill="currentColor" stroke="none"
          ></circle>
          <path d="M11.5 16.5v-6m0 1.6a2.6 2.6 0 0 1 5 1v3.4"></path>
        </svg>
        LinkedIn
      </a>
    </div>

    <p class="font-ui mt-10 text-xs text-fog-500">
      &copy; {year} Michelle Chang. Designed and built in San Francisco.
    </p>
  </div>
</footer>
