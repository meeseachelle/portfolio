---
interface Props {
  class?: string;
  // Thickening is applied in path units, so a mark rendered large needs far
  // less than one rendered at nav or favicon size. The base shape is traced
  // from the darkest core of the pen line, which keeps it fine at display
  // sizes; small contexts add weight back via this prop.
  strokeWidth?: number;
}

const { class: className, strokeWidth = 4 } = Astro.props;
---

<!-- Michelle's hand-drawn mark: an m that is also a wave. Vector-traced from
     the original ink drawing, so the pen's wobble, the tapered entry and the
     curled tail are the real ones rather than a redrawn approximation.

     Filled rather than stroked — the outline came from the trace, so the
     varying width of the actual pen is preserved. The stroke is the same
     colour as the fill; it isn't an outline, it's a way to fatten the shape.

     Uses currentColor so it inherits from surrounding text. aria-hidden
     because the adjacent text already names the link. -->
<svg
  viewBox="0 0 100 42.67"
  class={className}
  fill="currentColor"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
