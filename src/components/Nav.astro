---
const path = Astro.url.pathname;
const links = [
  { href: '/', label: 'Work' },
  { href: '/about', label: 'About' },
];
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---

<header class="mx-auto flex max-w-5xl items-baseline justify-between px-6 pt-8 pb-4 sm:px-8">
  <a
    href="/"
    class="font-display text-lg tracking-tight text-kelp-900 no-underline"
    aria-label="Michelle Chang, home"
  >
    Michelle Chang
  </a>

  <nav aria-label="Main">
    <ul class="flex list-none items-baseline gap-6 p-0 text-sm">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={isActive(link.href) ? 'page' : undefined}
              class:list={[
                'no-underline transition-colors',
                isActive(link.href)
                  ? 'text-kelp-900 underline decoration-seaglass-400 decoration-2 underline-offset-6'
                  : 'text-fog-500 hover:text-kelp-900',
              ]}
            >
              {link.label}
            </a>
          </li>
        ))
      }
      <li>
        <a
          href="mailto:meeseachelle@gmail.com"
          class="text-fog-500 no-underline transition-colors hover:text-kelp-900"
        >
          Email
        </a>
      </li>
    </ul>
  </nav>
</header>
