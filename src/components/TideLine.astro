---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<!-- The horizon rule. Used wherever a section break would otherwise be a
     hairline border — a wave reads as a tideline rather than a divider, which
     suits a site about oceans and systems more than a 1px grey line does.

     preserveAspectRatio="none" lets it stretch to any container width without
     the crests getting fatter; stroke-width stays visually constant because
     vector-effect keeps it in screen pixels. Decorative, so aria-hidden. -->
<svg
  viewBox="0 0 1000 24"
  class={className}
  preserveAspectRatio="none"
  aria-hidden="true"
  focusable="false"
>
  <path
    d="M0 14 C 90 4, 150 22, 250 13 S 420 3, 500 14 S 680 23, 780 12 S 920 5, 1000 15"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    vector-effect="non-scaling-stroke"></path>
</svg>
