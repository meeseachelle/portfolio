---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { habitats } from '../lib/habitats';

interface Props {
  entry: CollectionEntry<'work'>;
  index: number;
}

const { entry, index } = Astro.props;
const { title, company, summary, impact, tags, year, cover, coverAlt, habitat } =
  entry.data;
const habitatMeta = habitats[habitat];
---

<article
  class="unfurl group relative"
  style={`--unfurl-delay: ${Math.min(index, 3) * 90}ms`}
>
  <a
    href={`/work/${entry.id}`}
    class="block no-underline focus-visible:outline-offset-8"
  >
    <div
      class="overflow-hidden rounded-[1.25rem_1rem_1.5rem_1.125rem] border border-sand-200 bg-white"
    >
      {
        cover ? (
          <Image
            src={cover}
            alt={coverAlt ?? ''}
            widths={[480, 800, 1200]}
            sizes="(max-width: 768px) 92vw, 44vw"
            loading={index < 2 ? 'eager' : 'lazy'}
            class="aspect-[4/3] w-full object-cover transition-transform duration-700 ease-[cubic-bezier(0.22,0.61,0.36,1)] group-hover:scale-[1.02]"
          />
        ) : (
          <div
            class="flex aspect-[4/3] w-full items-center justify-center bg-sand-100"
            aria-hidden="true"
          >
            <span class="font-display text-sm text-fog-500">{company}</span>
          </div>
        )
      }
    </div>

    <div class="mt-5">
      <div class="flex items-baseline gap-3 text-xs text-fog-500">
        <span
          class="inline-flex items-center gap-1.5"
          style={`color: ${habitatMeta.color}`}
        >
          <span
            class="inline-block h-1.5 w-1.5 rounded-[60%_40%_55%_45%]"
            style={`background-color: ${habitatMeta.color}`}
            aria-hidden="true"></span>
          {habitatMeta.label}
        </span>
        <span aria-hidden="true">·</span>
        <span>{company}</span>
        <span aria-hidden="true">·</span>
        <span>{year}</span>
      </div>

      <h3
        class="mt-2 text-xl text-kelp-900 transition-colors group-hover:text-tide-600"
      >
        {title}
      </h3>

      <p class="mt-2 max-w-prose text-[0.9375rem] leading-relaxed text-kelp-700">
        {summary}
      </p>

      {
        impact && (
          <p class="mt-3 font-display text-[0.9375rem] text-tide-800">{impact}</p>
        )
      }

      <ul class="mt-4 flex list-none flex-wrap gap-2 p-0">
        {
          tags.map((tag) => (
            <li class="rounded-full border border-sand-200 px-2.5 py-1 text-xs text-fog-500">
              {tag}
            </li>
          ))
        }
      </ul>
    </div>
  </a>
</article>
