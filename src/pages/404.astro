---
import Base from '../layouts/Base.astro';
---

<Base
  title="Page not found | Michelle Chang"
  description="That page doesn't exist. Head back to the work."
>
  <section class="mx-auto max-w-5xl px-6 pt-24 pb-16 sm:px-8">
    <p class="text-sm text-fog-500">404</p>

    <h1 class="text-display mt-3 max-w-2xl text-kelp-900">
      This one drifted off the map.
    </h1>

    <p class="mt-6 max-w-xl text-[1.0625rem] leading-relaxed text-kelp-700">
      The page you're after isn't here. It may have moved, or the link may have
      been mistyped.
    </p>

    <div class="mt-8 flex flex-wrap gap-x-8 gap-y-3 text-[0.9375rem]">
      <a
        href="/"
        class="text-tide-600 underline decoration-1 underline-offset-4 hover:text-tide-800"
      >
        See the work
      </a>
      <a
        href="mailto:meeseachelle@gmail.com"
        class="text-fog-500 no-underline hover:text-kelp-900"
      >
        Email me instead
      </a>
    </div>
  </section>
</Base>
