---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import WorkCard from '../components/WorkCard.astro';
import FeaturedWorkCard from '../components/FeaturedWorkCard.astro';
import TideLine from '../components/TideLine.astro';
import HeroWash from '../components/HeroWash.astro';
import SandDollar from '../components/SandDollar.astro';

const work = (await getCollection('work', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order
);
const featured = work.filter((entry) => entry.data.featured);
const rest = work.filter((entry) => !entry.data.featured);
---

<Base
  title="Michelle Chang | Product designer, solving for systems and services"
  description="Product designer and systems-thinker in San Francisco building in supply chain, infrastructure, and sustainability. Work spanning maritime shipping, construction procurement, carbon measurement, regenerative farming, and applied AI."
  stackedNav
>
  <!-- Full-bleed wrapper so the wave spans the viewport rather than the
       content column. isolate scopes the multiply blending here so it can't
       tint the work grid; overflow-hidden clips the wave's horizontal
       overhang. The section inside stays centred at z-10, above the water. -->
  <div class="relative isolate overflow-hidden">
    <HeroWash />

    <section
      class="relative z-10 mx-auto max-w-5xl px-6 pt-16 pb-8 sm:px-8 sm:pt-24"
    >
      <SandDollar />
    <!-- No max-width cap: the line needs the full content column to stay on one
         line. nowrap only from sm up — below that the viewport is genuinely too
         narrow for 24 characters at hero size, so it wraps rather than
         overflowing. -->
    <h1 class="text-display text-kelp-900 sm:whitespace-nowrap">
      Human in nature.<br />Designer of experiences.
    </h1>

    <p class="text-lede mt-8 max-w-2xl leading-relaxed text-kelp-700">
      I'm a product designer and systems-thinker in San Francisco building in
      supply chain, infrastructure, and sustainability.
    </p>

    <p class="text-lede mt-5 max-w-2xl leading-relaxed text-kelp-700">
      Making waves and staying curious.
    </p>

    <p class="mt-6 flex max-w-2xl items-center gap-2.5 text-[0.9375rem] leading-relaxed text-fog-500">
      <!-- "Green light" status dot. The ping ring only runs for people who
           haven't asked for reduced motion; the solid dot always shows. -->
      <span class="relative flex h-1.5 w-1.5 shrink-0" aria-hidden="true">
        <span class="absolute inline-flex h-full w-full rounded-full bg-moss-500 opacity-60 motion-safe:animate-ping"></span>
        <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-moss-500"></span>
      </span>
      Available for full-time and contract product design opportunities.
    </p>

    <p class="mt-2 text-[0.9375rem] leading-relaxed">
      <!-- Emoji is decorative — the link text already says what this does, so
           it's hidden from screen readers rather than announced as
           "thought balloon". -->
      <span aria-hidden="true" class="mr-1.5">💭</span>
      <a
        href="mailto:meeseachelle@gmail.com"
        class="text-tide-600 underline decoration-1 underline-offset-4 hover:text-tide-800"
      >
        Start a conversation
      </a>
    </p>
    </section>
  </div>

  <!-- The horizon rule between introduction and work. -->
  <div class="mx-auto max-w-5xl px-6 sm:px-8">
    <TideLine class="h-6 w-full text-seaglass-200" />
  </div>

  <section class="mx-auto max-w-5xl px-6 py-12 sm:px-8" aria-labelledby="work-heading">
    <h2 id="work-heading" class="sr-only">Featured work</h2>

    <div class="grid gap-24">
      {featured.map((entry, i) => <FeaturedWorkCard entry={entry} index={i} />)}
    </div>

  </section>

  {
    rest.length > 0 && (
      <section
        class="mx-auto max-w-5xl px-6 pt-8 pb-16 sm:px-8"
        aria-labelledby="more-work-heading"
      >
        <TideLine class="h-6 w-full text-seaglass-200" />
        <h2 id="more-work-heading" class="text-title mt-12 text-kelp-900">
          More case studies
        </h2>

        <div class="mt-10 grid gap-x-10 gap-y-16 sm:grid-cols-2">
          {rest.map((entry, i) => (
            <WorkCard entry={entry} index={i} />
          ))}
        </div>
      </section>
    )
  }
</Base>
