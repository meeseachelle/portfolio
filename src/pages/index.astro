---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import WorkCard from '../components/WorkCard.astro';

const work = (await getCollection('work', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order
);
---

<Base
  title="Michelle Chang — Product designer, climate and ocean systems"
  description="Product designer with 6+ years of experience in San Francisco, blending ecosystem-thinking with design. Work across maritime shipping, carbon measurement, regenerative farming, and applied AI."
>
  <section class="mx-auto max-w-5xl px-6 pt-16 pb-8 sm:px-8 sm:pt-24">
    <h1 class="text-hero max-w-4xl text-kelp-900">
      Human in nature.<br />Designer of experiences.
    </h1>

    <p class="text-lede mt-8 max-w-2xl leading-relaxed text-kelp-700">
      I'm a product designer in San Francisco with six years of experience
      bringing ecosystem-thinking to complex tools — the ones used by captains
      crossing oceans, farmers reading soil, and teams measuring carbon they
      can't see.
    </p>

    <p class="mt-6 max-w-2xl text-[0.9375rem] leading-relaxed text-fog-500">
      Available for product design engagements.
      <a
        href="mailto:meeseachelle@gmail.com"
        class="text-tide-600 underline decoration-1 underline-offset-4 hover:text-tide-800"
      >
        Start a conversation
      </a>.
    </p>
  </section>

  <!-- A tideline: the horizon rule between introduction and work. -->
  <div class="mx-auto max-w-5xl px-6 sm:px-8" aria-hidden="true">
    <svg viewBox="0 0 1000 24" class="h-6 w-full" preserveAspectRatio="none">
      <path
        d="M0 14 C 90 4, 150 22, 250 13 S 420 3, 500 14 S 680 23, 780 12 S 920 5, 1000 15"
        fill="none"
        stroke="#c2ddd4"
        stroke-width="1.5"
        stroke-linecap="round"></path>
    </svg>
  </div>

  <section class="mx-auto max-w-5xl px-6 py-12 sm:px-8" aria-labelledby="work-heading">
    <h2 id="work-heading" class="sr-only">Selected work</h2>

    <div class="grid gap-x-10 gap-y-16 sm:grid-cols-2">
      {work.map((entry, i) => <WorkCard entry={entry} index={i} />)}
    </div>
  </section>
</Base>
